# Copy these into your Claude config's "env" block (or export them in your shell).
# The server reads environment variables only; it does not load a .env file.

# Base URL of your GitLab only (no project path after it)
GITLAB_URL=https://gitlab.company.com
GITLAB_TOKEN=your_token_here

# Read-only is the default. Set to false to enable comment/approve/retry/merge tools.
GITLAB_READONLY=true

# Optional
# GITLAB_DEFAULT_PROJECT=group/repo
# GITLAB_ALLOWED_PROJECTS=group/repo,group/other-repo
# MAX_OUTPUT_CHARS=60000
# REQUEST_TIMEOUT_MS=30000
# NODE_EXTRA_CA_CERTS=/path/to/company-ca.pem

# Test with the MCP Inspector from PowerShell:
#   $env:GITLAB_URL="https://gitlab.company.com"
#   $env:GITLAB_TOKEN="your_token_here"
#   Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass   # only if npx scripts are blocked
#   npm run inspect
#
# If that fails, pass the variables directly:
#   npx @modelcontextprotocol/inspector -e GITLAB_URL=https://gitlab.company.com -e GITLAB_TOKEN=your_token_here node build/index.js
